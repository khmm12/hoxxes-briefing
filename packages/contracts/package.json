{
	"name": "@hoxxes-briefing/contracts",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
		"test": "node --conditions=development --test --experimental-strip-types test/*.test.{ts,js}"
	},
	"dependencies": {
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@types/node": "^24.13.3",
		"typescript": "^7.0.2"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./api/v1": {
			"types": "./src/api/v1.ts",
			"development": "./src/api/v1.ts",
			"default": "./dist/api/v1.js"
		}
	},
	"types": "./src/index.ts"
}
