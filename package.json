{
	"name": "hoxxes-briefing-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"dev:web": "pnpm --filter @hoxxes-briefing/web dev",
		"dev:api": "pnpm --filter @hoxxes-briefing/api dev",
		"build": "pnpm -r --if-present run build",
		"test": "pnpm -r --if-present run test && cargo test --workspace",
		"check": "biome check && pnpm -r --if-present run typecheck && pnpm test && pnpm build"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a",
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@tsconfig/node24": "24.0.4",
		"@tsconfig/recommended": "1.0.13"
	}
}
