{
	"name": "hoxxes-briefing-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"dev:web": "pnpm --filter @hoxxes-briefing/web dev",
		"dev:api": "pnpm --filter @hoxxes-briefing/api dev",
		"build": "pnpm -r --if-present run build",
		"test": "pnpm -r --if-present run test && cargo test --workspace",
		"check": "biome check && pnpm -r --if-present run typecheck && pnpm test && pnpm build"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.0.6+sha512.97f906e1da2bedac3df83cadae04b4753a130092dd49d55cd36825ad3e623e9df3f97754f8f259e699172a360fac569acf2f908e7732bdae3eddb2dcf7e121fd",
	"devDependencies": {
		"@biomejs/biome": "2.4.13",
		"@tsconfig/node24": "24.0.4",
		"@tsconfig/recommended": "1.0.13"
	}
}
