{
	"name": "hoxxes-briefing-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"dev:web": "pnpm --filter @hoxxes-briefing/web dev",
		"dev:api": "pnpm --filter @hoxxes-briefing/api dev",
		"build": "pnpm -r --if-present run build",
		"test": "pnpm -r --if-present run test && cargo test --workspace",
		"check": "biome check && pnpm -r --if-present run lint:fsd && pnpm -r --if-present run typecheck && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && pnpm test && pnpm build"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@tsconfig/node24": "24.0.5",
		"@tsconfig/recommended": "1.0.13"
	}
}
