{
	"name": "hoxxes-briefing-workspace",
	"private": true,
	"type": "module",
	"scripts": {
		"dev:web": "pnpm --filter @hoxxes-briefing/web dev",
		"dev:api": "pnpm --filter @hoxxes-briefing/api dev",
		"build": "pnpm -r --if-present run build",
		"test": "pnpm -r --if-present run test && cargo test --workspace",
		"check": "biome check && pnpm -r --if-present run typecheck && pnpm test && pnpm build"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499",
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@tsconfig/node24": "24.0.4",
		"@tsconfig/recommended": "1.0.13"
	}
}
