{
	"name": "@hoxxes-briefing/web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "panda codegen --clean && vite dev --host 127.0.0.1 --port 5173",
		"build": "panda codegen --clean && vite build",
		"gen:icons": "node scripts/generate-icons.ts",
		"gen:og": "node scripts/generate-og-image.ts",
		"lint:fsd": "steiger ./src",
		"test": "vitest run",
		"typecheck": "panda codegen --clean && tsc -b tsconfig.json",
		"prepare": "panda codegen --clean"
	},
	"sideEffects": [
		"*.css"
	],
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"@fontsource/ibm-plex-sans": "^5.2.8",
		"@fontsource/rajdhani": "^5.2.7",
		"@hoxxes-briefing/contracts": "workspace:*",
		"@lingui/core": "^6.4.0",
		"@solidjs/router": "0.17.0-next.3",
		"@solidjs/web": "2.0.0-beta.15",
		"date-fns": "^4.4.0",
		"embla-carousel": "^8.6.0",
		"solid-js": "2.0.0-beta.15",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@feature-sliced/steiger-plugin": "^0.6.0",
		"@lingui/babel-plugin-lingui-macro": "^6.4.0",
		"@lingui/cli": "^6.4.0",
		"@lingui/vite-plugin": "^6.4.0",
		"@pandacss/dev": "^1.11.4",
		"@resvg/resvg-js": "^2.6.2",
		"@rolldown/plugin-babel": "^0.2.3",
		"@solidjs/testing-library": "1.0.0-beta.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "^24.13.2",
		"@vite-pwa/assets-generator": "^1.0.2",
		"@vitest/coverage-v8": "4.1.9",
		"jsdom": "^29.1.1",
		"satori": "^0.26.0",
		"steiger": "^0.5.13",
		"typescript": "^6.0.3",
		"vite": "^8.1.0",
		"vite-plugin-pwa": "^1.3.0",
		"vite-plugin-solid": "3.0.0-next.5",
		"vitest": "^4.1.9",
		"workbox-cacheable-response": "^7.4.1",
		"workbox-expiration": "^7.4.1",
		"workbox-precaching": "^7.4.1",
		"workbox-routing": "^7.4.1",
		"workbox-strategies": "^7.4.1",
		"workbox-window": "^7.4.1"
