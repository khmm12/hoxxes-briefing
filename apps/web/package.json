{
	"name": "@hoxxes-briefing/web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "panda codegen --clean && vite dev --host 127.0.0.1 --port 5173",
		"build": "panda codegen --clean && vite build",
		"gen:icons": "node scripts/generate-icons.ts",
		"gen:og": "node scripts/generate-og-image.ts",
		"lint:fsd": "steiger ./src",
		"test": "vitest run",
		"typecheck": "panda codegen --clean && tsc -b tsconfig.json",
		"prepare": "panda codegen --clean"
	},
	"sideEffects": [
		"*.css"
	],
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"@fontsource/ibm-plex-sans": "^5.3.0",
		"@fontsource/rajdhani": "^5.3.0",
		"@hoxxes-briefing/contracts": "workspace:*",
		"@lingui/core": "^6.6.0",
		"@solidjs/router": "2.0.0-next.12",
		"@solidjs/web": "2.0.0-beta.28",
		"date-fns": "^4.4.0",
		"embla-carousel": "^8.6.0",
		"solid-js": "2.0.0-beta.28",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@date-fns/utc": "^2.1.1",
		"@feature-sliced/steiger-plugin": "^0.7.0",
		"@lingui/babel-plugin-lingui-macro": "^6.6.0",
		"@lingui/cli": "^6.6.0",
		"@lingui/vite-plugin": "^6.6.0",
		"@pandacss/dev": "^1.12.0",
		"@resvg/resvg-js": "^2.6.2",
		"@rolldown/plugin-babel": "^0.2.3",
		"@solidjs/testing-library": "1.0.0-beta.2",
		"@testing-library/jest-dom": "^6.10.0",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "^24.13.3",
		"@vite-pwa/assets-generator": "^1.0.2",
		"@vitest/coverage-v8": "4.1.10",
		"happy-dom": "^20.11.1",
		"satori": "^0.29.0",
		"steiger": "^0.6.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.0",
		"vite-plugin-minify": "^3.0.0",
		"vite-plugin-pwa": "^1.3.0",
		"vite-plugin-solid": "3.0.0-next.20",
		"vitest": "^4.1.10",
		"workbox-precaching": "^7.4.1",
		"workbox-routing": "^7.4.1",
		"workbox-window": "^7.4.1"
