{
	"name": "@hoxxes-briefing/web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "panda codegen --clean && vite dev --host 127.0.0.1 --port 5173",
		"build": "panda codegen --clean && vite build",
		"test": "vitest run",
		"typecheck": "panda codegen --clean && tsc -b tsconfig.json",
		"prepare": "panda codegen --clean"
	},
	"sideEffects": [
		"*.css"
	],
	"engines": {
		"node": ">=24"
	},
	"dependencies": {
		"@hoxxes-briefing/contracts": "workspace:*",
		"@lingui/core": "^6.0.1",
		"@solidjs/meta": "next",
		"@solidjs/router": "next",
		"@solidjs/web": "next",
		"date-fns": "^4.1.0",
		"solid-js": "next"
	},
	"devDependencies": {
		"@lingui/babel-plugin-lingui-macro": "^6.0.1",
		"@lingui/cli": "^6.0.1",
		"@lingui/vite-plugin": "^6.0.1",
		"@pandacss/dev": "^1.11.0",
		"@resvg/resvg-js": "^2.6.2",
		"@rolldown/plugin-babel": "^0.2.3",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/node": "25.6.0",
		"@vite-pwa/assets-generator": "^1.0.2",
		"satori": "^0.26.0",
		"typescript": "6.0.3",
		"vite": "^8.0.10",
		"vite-plugin-pwa": "^1.2.0",
		"vite-plugin-solid": "next",
		"vitest": "^4.1.5",
		"workbox-cacheable-response": "^7.4.1",
		"workbox-expiration": "^7.4.1",
		"workbox-precaching": "^7.4.1",
		"workbox-routing": "^7.4.1",
		"workbox-strategies": "^7.4.1",
		"workbox-window": "^7.4.1"
	},
	"overrides": {
		"vite-plugin-pwa": {
			"vite": "$vite"
		}
	}
