{
	"name": "@hoxxes-briefing/api",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --conditions=development --watch --experimental-strip-types src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"test": "node --conditions=development --test --experimental-strip-types test/*.test.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@hoxxes-briefing/contracts": "workspace:*",
		"@hoxxes-briefing/wasm": "workspace:*",
		"@hono/node-server": "^2.0.0",
		"hono": "^4.12.15"
	},
	"exports": {
		".": {
			"types": "./src/app.ts",
			"development": "./src/app.ts",
			"default": "./dist/app.js"
		}
	},
	"types": "./src/app.ts",
	"devDependencies": {
		"@types/node": "25.6.0",
		"typescript": "6.0.3"
	}
}
