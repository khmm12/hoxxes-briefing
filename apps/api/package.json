{
	"name": "@hoxxes-briefing/api",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "node --conditions=development --watch --experimental-strip-types src/index.ts",
		"build": "tsc -p tsconfig.build.json",
		"test": "node --conditions=development --test --experimental-strip-types \"src/**/*.test.ts\" \"test/*.test.ts\"",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@date-fns/utc": "^2.1.1",
		"@hono/node-server": "^2.0.2",
		"@hoxxes-briefing/contracts": "workspace:*",
		"@hoxxes-briefing/wasm": "workspace:*",
		"date-fns": "^4.1.0",
		"hono": "^4.12.18",
		"valibot": "^1.4.0"
	},
	"exports": {
		".": {
			"types": "./src/app.ts",
			"development": "./src/app.ts",
			"default": "./dist/app.js"
		}
	},
	"types": "./src/app.ts",
	"devDependencies": {
		"@types/node": "^24.12.4",
		"typescript": "^6.0.3"
	}
}
